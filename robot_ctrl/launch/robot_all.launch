<launch>
    <!-- 机器人参数配置文件路径 -->
    <arg name="config_file" default="$(find robot_ctrl)/config/params.yaml" />

    <!-- 机器人控制节点 -->
    <node name="robot_node" pkg="robot_ctrl" type="robot_node" output="screen">
        <param name="config_file" value="$(arg config_file)" />
    </node>

    <node pkg = "robot_ctrl" type = "tcp_node"  name = "tcp_node" output = "screen" />
    <node pkg = "robot_ctrl" type = "front_node.py"  name = "front_node" output = "screen" />
    <!-- <node pkg = "robot_ctrl" type = "back_node.py"  name =  "back_node" output = "screen" /> -->
    <node pkg = "robot_ctrl" type = "push_node.py"  name =  "push_node" output = "screen" />
    <include file="$(find robot_ctrl)/launch/robot_imu.launch" />

    <!-- roslaunch ros_rtsp rtsp_streams.launch -->
    <include file="$(find ros_rtsp)/launch/rtsp_streams.launch" />
    <!-- rosrun camera_ctrl camera_node.py -->
    <node pkg = "camera_ctrl" type = "camera_node.py"  name =  "camera_node" output = "screen" />

</launch>